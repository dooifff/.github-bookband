# StudioBook Web (Admin Dashboard)

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Google Sign-In (OAuth Client ID tipe "Web application")
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# App Configuration
VITE_APP_NAME=StudioBook Admin
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0

# Unduhan APK Android (halaman /download)
# Default: /downloads/studiobook.apk (letakkan file di web/public/downloads/)
# VITE_APK_URL=https://contoh.com/path/studiobook.apk
