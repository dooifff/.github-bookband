  "endpoints": [
    {
      "name": "Health Check",
      "method": "GET",
      "url": "/api/health",
      "auth_required": false,
      "category": "public"
    },
    {
      "name": "Studios List",
      "method": "GET",
      "url": "/api/v1/studios",
      "auth_required": false,
      "category": "public"
    },
    {
