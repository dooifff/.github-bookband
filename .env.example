APP_NAME=StudioBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=studiobook
DB_USERNAME=studiobook
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail (Mailhog for development)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@studiobook.com
MAIL_FROM_NAME="StudioBook"

# Performance Monitoring
PERFORMANCE_ALERT_EMAIL=admin@studiobook.com
PERFORMANCE_WEBHOOK_SLACK=
PERFORMANCE_WEBHOOK_DISCORD=
PERFORMANCE_EMAIL_WEEKLY=true
PERFORMANCE_EMAIL_MONTHLY=true
