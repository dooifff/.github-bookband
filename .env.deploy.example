# ============================================
# StudioBook - InfinityFree Deployment Config
# ============================================

# FTP Configuration (dari control panel InfinityFree)
FTP_HOST=ftpupload.net
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# API URL (domain kamu)
API_URL=https://yourdomain.com

# Database Configuration (dari control panel InfinityFree)
DB_HOST=mysql.epizy.com
DB_DATABASE=epiz_your_database
DB_USERNAME=epiz_your_username
DB_PASSWORD=your_database_password
