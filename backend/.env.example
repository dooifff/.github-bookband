APP_NAME=StudioBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studiobook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=studiobook

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173

# CORS
FRONTEND_URL=http://localhost:5173
MOBILE_SCHEME=studiobook

# Payment Gateway (Midtrans)
# Get your API keys from https://dashboard.midtrans.com/access
# Sandbox: SB-Mid-server-xxxxx & SB-Mid-client-xxxxx
# Production: Mid-server-xxxxx & Mid-client-xxxxx
# Leave empty to use sandbox mode (auto-approved payments for testing)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=${APP_URL}/api/v1/payments/webhook

# Xendit (alternative payment)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Firebase (for FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Storage
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@studiobook.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Sign-In (daftar OAuth Client ID, pisahkan dengan koma)
# Urutan contoh: web, Android, iOS
GOOGLE_CLIENT_IDS=

# Studio Subscription Enforcement (cron peringatan & penghapusan otomatis)
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
SUBSCRIPTION_WARN1_DAYS=1
SUBSCRIPTION_WARN2_DAYS=3
SUBSCRIPTION_DELETE_DAYS=7
SUBSCRIPTION_RENEWAL_MONTHS=1
SUBSCRIPTION_CHECK_TIME=06:00
